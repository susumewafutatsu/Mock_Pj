# Mẫu biến môi trường cho backend. Copy thành .env rồi điền giá trị thật.
# File .env đã bị .gitignore chặn — không bao giờ commit giá trị thật lên git.

# MySQL cục bộ của từng người
DB_USERNAME=root
DB_PASSWORD=

# Google OAuth2 (lấy trong Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dữ liệu mẫu do Liquibase nạp. Bỏ trống hoặc không khai báo -> mặc định "demo",
# tức app tự nạp sẵn tài khoản/lớp/câu hỏi/đề thi mẫu cho mọi máy trong team.
# Đặt thành "production" nếu muốn DB sạch, chỉ có schema + danh mục dùng chung.
LIQUIBASE_CONTEXTS=demo
